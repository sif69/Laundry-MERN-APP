# MongoDB connection string (use MongoDB Atlas recommended)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# If you deploy server and client separately, set CLIENT_ORIGIN to your frontend URL
# Example: https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# Server port (host will usually set this)
PORT=5000

# Use to serve client from server if desired (optional)
# SERVE_CLIENT=false

# Any other secrets:
# JWT_SECRET=your_jwt_secret
# STRIPE_SECRET=sk_test_...